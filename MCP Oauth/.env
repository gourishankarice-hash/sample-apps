# Server Configuration
PORT=3000
HOST=http://localhost:3000

# OAuth Configuration
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
TOKEN_EXPIRY=1h

# Pre-registered OAuth Clients
# Format: CLIENT_ID:CLIENT_SECRET (comma-separated for multiple)
# These are the credentials Copilot Studio will use
COPILOT_CLIENT_ID=copilot-studio-client
COPILOT_CLIENT_SECRET=copilot-studio-secret-change-me

DEMO_CLIENT_ID=demo-client
DEMO_CLIENT_SECRET=demo-secret-change-me

# Optional: Azure AD / Entra ID integration (for production)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-client-id
# AZURE_CLIENT_SECRET=your-app-client-secret
