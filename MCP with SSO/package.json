{
  "name": "pingfederate-mcp-server",
  "version": "1.0.0",
  "description": "MCP server with PingFederate OAuth 2.0 and OIDC integration for Microsoft Copilot Studio",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "watch": "tsc --watch",
    "dev:watch": "tsc --watch --preserveWatchOutput & node dist/server.js"
  },
  "keywords": [
    "mcp",
    "pingfederate",
    "oauth2",
    "oidc",
    "copilot",
    "sso"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
