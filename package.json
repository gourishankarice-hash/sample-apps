{
  "name": "mcp-gateway",
  "version": "1.0.0",
  "description": "A Model Context Protocol gateway for aggregating and routing requests across multiple MCP servers",
  "type": "module",
  "main": "dist/gateway/index.js",
  "scripts": {
    "build": "tsc --build",
    "build:ui": "npm --prefix ui install && npm --prefix ui run build",
    "build:all": "npm run build && npm run build:ui",
    "start": "node dist/gateway/index.js",
    "start:calculator": "node dist/servers/calculator/index.js",
    "start:weather": "node dist/servers/weather/index.js",
    "dev": "tsx watch src/gateway/index.ts",
    "dev:ui": "npm --prefix ui run dev",
    "dev:calculator": "tsx src/servers/calculator/index.ts",
    "dev:weather": "tsx src/servers/weather/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
